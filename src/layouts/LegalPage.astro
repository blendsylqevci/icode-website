---
// Shared shell for the legal / store-compliance pages (privacy, terms,
// support, delete-account). Long-form copy goes in two named slots, one per
// language, toggled by site.js via [data-lang-block]. The SQ block ships with
// .show so the page is readable without JS; ?lang=en opens it in English.
import Base from './Base.astro';
import { COMPANY, addressLine } from '../data/company.js';

interface Props {
  title: string;
  description: string;
  crumb: { sq: string; en: string };
  heading: { sq: string; en: string };
  lead?: { sq: string; en: string };
  showUpdated?: boolean;
}

const { title, description, crumb, heading, lead, showUpdated = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');

const DOCS = [
  { href: '/privacy', sq: 'Politika e privatësisë', en: 'Privacy policy' },
  { href: '/terms', sq: 'Kushtet e përdorimit', en: 'Terms of use' },
  { href: '/support', sq: 'Mbështetja', en: 'Support' },
  { href: '/delete-account', sq: 'Fshirja e llogarisë', en: 'Account deletion' },
  { href: '/cookies', sq: 'Politika e cookies', en: 'Cookie policy' },
];
---
<Base title={title} description={description}>

<section class="page-hero">
  <div class="container-wide">
    <div class="crumbs"><a href="/" data-sq="Ballina" data-en="Home">Ballina</a><span class="sep">/</span><span data-sq={crumb.sq} data-en={crumb.en}>{crumb.sq}</span></div>
    <h1 class="legal-h1" data-reveal data-sq={heading.sq} data-en={heading.en}>{heading.sq}</h1>
    {lead && <p class="lead" data-reveal data-reveal-delay="1" data-sq={lead.sq} data-en={lead.en}>{lead.sq}</p>}
    {showUpdated && (
      <p class="legal-updated"><span data-sq="Përditësuar më:" data-en="Last updated:">Përditësuar më:</span> <time datetime={COMPANY.legalUpdated.iso} data-sq={COMPANY.legalUpdated.sq} data-en={COMPANY.legalUpdated.en}>{COMPANY.legalUpdated.sq}</time></p>
    )}
  </div>
</section>

<section class="section-sm">
  <div class="container-wide legal-grid">
    <article class="legal">
      <div data-lang-block="sq" class="show" lang="sq"><slot name="sq" /></div>
      <div data-lang-block="en" lang="en"><slot name="en" /></div>
    </article>

    <aside class="legal-aside">
      <div class="legal-card">
        <h5 data-sq="Kompania" data-en="Company">Kompania</h5>
        <p class="legal-entity">{COMPANY.legalName}</p>
        {COMPANY.regNumber && <p><span data-sq="Nr. i biznesit (NUI):" data-en="Business reg. no.:">Nr. i biznesit (NUI):</span> {COMPANY.regNumber}</p>}
        {COMPANY.vatNumber && <p><span data-sq="Nr. fiskal / TVSH:" data-en="VAT / fiscal no.:">Nr. fiskal / TVSH:</span> {COMPANY.vatNumber}</p>}
        <p data-sq={addressLine('sq')} data-en={addressLine('en')}>{addressLine('sq')}</p>
        <p><a href={`mailto:${COMPANY.privacyEmail}`}>{COMPANY.privacyEmail}</a><br /><a href={`tel:${COMPANY.phoneHref}`}>{COMPANY.phone}</a></p>
      </div>
      <div class="legal-card">
        <h5 data-sq="Dokumente" data-en="Documents">Dokumente</h5>
        <nav class="legal-docs">
          {DOCS.map((d) => (
            <a href={d.href} class={path === d.href ? 'on' : undefined} aria-current={path === d.href ? 'page' : undefined} data-sq={d.sq} data-en={d.en}>{d.sq}</a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</section>

</Base>

<style is:global>
.legal-h1{font-size:clamp(2.3rem,5vw,4.2rem);}
.legal-updated{margin-top:22px;font-family:var(--ff-head);font-size:.88rem;color:var(--muted);}
.legal-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(36px,5vw,80px);align-items:start;}
@media (max-width:940px){.legal-grid{grid-template-columns:minmax(0,1fr);}}

.legal{max-width:780px;min-width:0;color:var(--ink-soft);font-size:1.02rem;}
.legal h2{font-size:clamp(1.35rem,2vw,1.7rem);letter-spacing:-.02em;margin:52px 0 16px;scroll-margin-top:110px;}
.legal h2:first-child{margin-top:0;}
.legal h3{font-size:1.12rem;letter-spacing:-.01em;margin:28px 0 10px;}
.legal p{margin-bottom:14px;}
.legal ul,.legal ol{margin:0 0 16px;padding-left:22px;}
.legal ul{list-style:disc;}
.legal ol{list-style:decimal;}
.legal li{margin-bottom:7px;padding-left:4px;}
.legal li::marker{color:var(--primary);}
.legal a{color:var(--primary);text-decoration:underline;text-underline-offset:3px;}
.legal strong{color:var(--ink);font-weight:600;}
.legal .legal-summary{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--r);padding:22px 26px;margin-bottom:8px;}
.legal .legal-summary p:last-child,.legal .legal-summary ul:last-child{margin-bottom:0;}
.legal .table-wrap{overflow-x:auto;margin:6px 0 18px;border:1px solid var(--line);border-radius:var(--r);}
.legal table{width:100%;border-collapse:collapse;font-size:.95rem;min-width:520px;}
.legal th,.legal td{text-align:left;vertical-align:top;padding:12px 16px;border-bottom:1px solid var(--line);}
.legal th{font-family:var(--ff-head);font-weight:600;font-size:.84rem;background:var(--bg-soft);color:var(--ink);}
.legal tr:last-child td{border-bottom:none;}
@media (max-width:560px){.legal table{min-width:0;font-size:.88rem;}.legal th,.legal td{padding:10px 12px;}}

.legal-aside{position:sticky;top:110px;display:grid;gap:16px;}
@media (max-width:940px){.legal-aside{position:static;}}
.legal-card{border:1px solid var(--line);border-radius:var(--r-lg);padding:24px 26px;background:#fff;font-size:.93rem;color:var(--muted);}
.legal-card h5{font-family:var(--ff-head);font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-2);margin-bottom:12px;}
.legal-card p{margin-bottom:8px;}
.legal-card p:last-child{margin-bottom:0;}
.legal-card .legal-entity{font-family:var(--ff-head);font-weight:600;color:var(--ink);font-size:1rem;}
.legal-card a:hover{color:var(--primary);}
.legal-docs a{display:block;padding:8px 0;border-bottom:1px solid var(--line);font-family:var(--ff-head);font-weight:500;color:var(--ink);}
.legal-docs a:last-child{border-bottom:none;}
.legal-docs a.on{color:var(--primary);font-weight:600;}
</style>
