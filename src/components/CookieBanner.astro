---
// Cookie consent banner. Hidden until site.js finds no stored choice; also
// reopened by any [data-open-consent] control. "Essential only" is given the
// same weight as "Accept all" (consent must be as easy to refuse as to give).
---
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-modal="false" aria-labelledby="cookie-title" hidden>
  <b id="cookie-title" class="cookie-title" data-sq="Cookies dhe privatësia" data-en="Cookies & privacy">Cookies dhe privatësia</b>
  <p class="cookie-text">
    <span data-sq="Përdorim vetëm ruajtje të domosdoshme (gjuha dhe kjo zgjedhje). Me pëlqimin tuaj ngarkojmë Google Maps në faqen e kontaktit, që vendos cookies të Google." data-en="We only use essential storage (your language and this choice). With your consent we load Google Maps on the contact page, which sets Google cookies.">Përdorim vetëm ruajtje të domosdoshme (gjuha dhe kjo zgjedhje). Me pëlqimin tuaj ngarkojmë Google Maps në faqen e kontaktit, që vendos cookies të Google.</span>{' '}
    <a href="/cookies" data-sq="Politika e cookies" data-en="Cookie policy">Politika e cookies</a>
  </p>
  <div class="cookie-actions">
    <button type="button" class="btn btn-outline" data-consent="necessary" data-sq="Vetëm të domosdoshmet" data-en="Essential only">Vetëm të domosdoshmet</button>
    <button type="button" class="btn btn-primary" data-consent="all" data-sq="Prano të gjitha" data-en="Accept all">Prano të gjitha</button>
  </div>
</div>
