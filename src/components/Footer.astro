---
// Server-rendered site footer. Social links ordered: LinkedIn, X, Facebook, Instagram.
// Legal entity line + legal links are required by Apple / Google Play reviews.
import { COMPANY, addressLine } from '../data/company.js';
const C = COMPANY;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="/"><img class="brand-logo" src="/brand/logo-white.png" alt="iCode" width="1042" height="361" loading="lazy" /></a>
        <p data-sq="Prej 10 vitesh ndërtojmë platforma softuerike — ERP, POS, WMS & OMS — aplikacione mobile dhe integrime AI për biznese që rriten." data-en="For 10 years we have built software platforms — ERP, POS, WMS & OMS — mobile apps and AI integrations for growing businesses.">Prej 10 vitesh ndërtojmë platforma softuerike — ERP, POS, WMS & OMS — aplikacione mobile dhe integrime AI për biznese që rriten.</p>
        <div class="socials">
          <a href="https://www.linkedin.com/company/icode-ks" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.5 8H3v13h3.5zM4.7 3a2 2 0 100 4 2 2 0 000-4zM21 21h-3.5v-7c0-1.7-.6-2.6-1.9-2.6-1.1 0-1.7.7-2 1.5-.1.3-.1.7-.1 1V21H10s.05-11 0-12h3.5v1.7c.5-.8 1.3-1.9 3.3-1.9 2.4 0 4.2 1.6 4.2 5z"/></svg></a>
          <a href="https://x.com/icode_ks" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 3h3l-7 8 8 10h-6l-5-6-5 6H2l8-9L2 3h6l4 5z"/></svg></a>
          <a href="https://www.facebook.com/icode.ks" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V5h-3c-2.2 0-4 1.8-4 4v2H7v4h3v6h4v-6h3l1-4h-4V9c0-.6.4-1 1-1z"/></svg></a>
          <a href="https://www.instagram.com/icode_ks" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        </div>
      </div>
      <div class="footer-col"><h5 data-sq="Shërbimet" data-en="Services">Shërbimet</h5>
        <a href="/erp-platform" data-sq="Platformë ERP" data-en="ERP Platform">Platformë ERP</a>
        <a href="/pos-system" data-sq="Sistem POS" data-en="POS System">Sistem POS</a>
        <a href="/wms-oms" data-sq="WMS & OMS" data-en="WMS & OMS">WMS & OMS</a>
        <a href="/mobile-apps" data-sq="Aplikacione Mobile" data-en="Mobile Apps">Aplikacione Mobile</a>
        <a href="/ecommerce" data-sq="E-Commerce" data-en="E-Commerce">E-Commerce</a>
        <a href="/custom-software" data-sq="Custom Software" data-en="Custom Software">Custom Software</a>
        <a href="/web-development" data-sq="Zhvillim Web" data-en="Web Development">Zhvillim Web</a>
        <a href="/ui-ux-design" data-sq="UI/UX Design" data-en="UI/UX Design">UI/UX Design</a>
        <a href="/game-engine-3d" data-sq="Game Engine & 3D" data-en="Game Engine & 3D">Game Engine & 3D</a>
        <a href="/ai-cloud" data-sq="Integrime AI & Cloud" data-en="AI & Cloud">Integrime AI & Cloud</a>
      </div>
      <div class="footer-col"><h5 data-sq="Kompania" data-en="Company">Kompania</h5>
        <a href="/about" data-sq="Rreth nesh" data-en="About us">Rreth nesh</a>
        <a href="/portfolio" data-sq="Projekte" data-en="Work">Projekte</a>
        <a href="/process" data-sq="Procesi" data-en="Process">Procesi</a>
        <a href="/industries" data-sq="Industritë" data-en="Industries">Industritë</a>
        <a href="/careers" data-sq="Karriera" data-en="Careers">Karriera</a>
        <a href="/blog" data-sq="Blog" data-en="Blog">Blog</a>
      </div>
      <div class="footer-col"><h5 data-sq="Kontakti" data-en="Contact">Kontakti</h5>
        <a href={`tel:${C.phoneHref}`}>{C.phone}</a>
        <a href={`mailto:${C.email}`}>{C.email}</a>
        <a href={`mailto:${C.officeEmail}`}>{C.officeEmail}</a>
        <span class="footer-addr" data-sq={addressLine('sq')} data-en={addressLine('en')}>{addressLine('sq')}</span>
        <a class="btn btn-primary" href="/contact" style="margin-top:14px;display:inline-flex;" data-sq="Nis një projekt" data-en="Start a project">Nis një projekt</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-legal">
        <span data-sq={`© ${year} ${C.legalName}. Të gjitha të drejtat e rezervuara.`} data-en={`© ${year} ${C.legalName}. All rights reserved.`}>© {year} {C.legalName}. Të gjitha të drejtat e rezervuara.</span>
        {C.regNumber && <span><span data-sq="NUI" data-en="Reg. no.">NUI</span> {C.regNumber}</span>}
      </div>
      <nav class="links" aria-label="Legal">
        <a href="/privacy" data-sq="Privatësia" data-en="Privacy">Privatësia</a>
        <a href="/terms" data-sq="Kushtet" data-en="Terms">Kushtet</a>
        <a href="/support" data-sq="Mbështetja" data-en="Support">Mbështetja</a>
        <a href="/delete-account" data-sq="Fshirja e llogarisë" data-en="Delete account">Fshirja e llogarisë</a>
        <a href="/cookies" data-sq="Cookies" data-en="Cookies">Cookies</a>
        <button type="button" data-open-consent data-sq="Cilësimet e cookies" data-en="Cookie settings">Cilësimet e cookies</button>
      </nav>
    </div>
  </div>
</footer>
