      <li class="nav-item"><a class={`nav-link${active('company')}`} href="/about">
        <span data-sq="Kompania" data-en="Company">Kompania</span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
