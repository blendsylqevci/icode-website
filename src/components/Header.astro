      <li class="nav-item"><a class={`nav-link${active('platforms')}`} href="/services">
        <span data-sq="Platformat" data-en="Platforms">Platformat</span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="dropdown"><div class="dd-wrap dd-cols">
          <div><div class="dd-title" data-sq="PLATFORMAT" data-en="PLATFORMS">PLATFORMAT</div><div class="dd-list">
            <a class="dd-a" href="/erp-platform"><i>›</i><span data-sq="Platformë ERP" data-en="ERP Platform">Platformë ERP</span></a>
            <a class="dd-a" href="/pos-system"><i>›</i><span data-sq="Sistem POS" data-en="POS System">Sistem POS</span></a>
            <a class="dd-a" href="/wms-oms"><i>›</i><span data-sq="WMS & OMS" data-en="WMS & OMS">WMS & OMS</span></a>
            <a class="dd-a" href="/ecommerce"><i>›</i><span data-sq="E-Commerce" data-en="E-Commerce">E-Commerce</span></a>
            <a class="dd-a" href="/ai-cloud"><i>›</i><span data-sq="Integrime AI & Cloud" data-en="AI & Cloud">Integrime AI & Cloud</span></a>
          </div></div>
          <div><div class="dd-title" data-sq="SI PUNOJMË" data-en="HOW WE WORK">SI PUNOJMË</div><div class="dd-list">
            <a class="dd-a" href="/process"><i>›</i><span data-sq="Procesi ynë" data-en="Our process">Procesi ynë</span></a>
            <a class="dd-a" href="/industries"><i>›</i><span data-sq="Industritë" data-en="Industries">Industritë</span></a>
            <a class="dd-a" href="/portfolio#cat=erp"><i>›</i><span data-sq="Raste ERP & POS" data-en="ERP & POS cases">Raste ERP & POS</span></a>
          </div></div>
          <div class="dd-cta"><h4 data-sq="Nis me një demo të platformës." data-en="Start with a platform demo.">Nis me një demo të platformës.</h4>
            <div class="dd-cta-rows">
