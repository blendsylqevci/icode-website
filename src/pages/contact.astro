---
import Base from '../layouts/Base.astro';
import { COMPANY, addressLine } from '../data/company.js';
const C = COMPANY;
---
<Base
  title="Kontakti — iCode LLC"
  description="Na kontakto: +383 48 331 333, info@icode-ks.com. iCode LLC, Gjilan, Kosovë. Bisedë falas 30-minutëshe për projektin tënd."
>

<section class="page-hero on-dark-hero">
  <div class="container-wide">
    <div class="crumbs"><a href="/" data-sq="Ballina" data-en="Home">Ballina</a><span class="sep">/</span><span data-sq="Kontakti" data-en="Contact">Kontakti</span></div>
    <h1 data-reveal data-sq="Le të bisedojmë për projektin tënd" data-en="Let's talk about your project">Le të bisedojmë për projektin tënd</h1>
    <p class="lead" data-reveal data-reveal-delay="1" data-sq="Plotëso formularin ose na shkruaj direkt. Të kthehemi brenda një dite pune me hapat e parë." data-en="Fill in the form or write to us directly. We'll get back within one business day with the first steps.">Plotëso formularin ose na shkruaj direkt. Të kthehemi brenda një dite pune me hapat e parë.</p>
  </div>
</section>

<section class="section">
  <div class="container-wide">
    <div class="contact-grid">
      <!-- info -->
      <div data-reveal>
        <span class="eyebrow" data-sq="Kontakti" data-en="Get in touch">Kontakti</span>
        <h2 data-sq="Jemi këtu për të ndihmuar" data-en="We're here to help">Jemi këtu për të ndihmuar</h2>
        <div class="mt-l">
          <div class="contact-info-item"><span class="ci-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5a2 2 0 012-2h2l2 5-2 1a12 12 0 006 6l1-2 5 2v2a2 2 0 01-2 2A16 16 0 014 5z"/></svg></span><div><b data-sq="Telefon" data-en="Phone">Telefon</b><a href={`tel:${C.phoneHref}`}>{C.phone}</a></div></div>
          <div class="contact-info-item"><span class="ci-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><div><b>Email</b><a href={`mailto:${C.email}`}>{C.email}</a><br><a href={`mailto:${C.officeEmail}`}>{C.officeEmail}</a></div></div>
          <div class="contact-info-item"><span class="ci-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><div><b data-sq="Adresa" data-en="Address">Adresa</b><a href={C.mapsUrl} target="_blank" rel="noopener" data-sq={addressLine('sq')} data-en={addressLine('en')}>{addressLine('sq')}</a></div></div>
          <div class="contact-info-item"><span class="ci-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><b data-sq="Orari" data-en="Hours">Orari</b><span data-sq="Hën–Pre, 09:00–17:00" data-en="Mon–Fri, 09:00–17:00">Hën–Pre, 09:00–17:00</span></div></div>
          <div class="contact-info-item"><span class="ci-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><div><b data-sq="Kompania" data-en="Company">Kompania</b><span>{C.legalName}{C.regNumber && <><br /><span data-sq={`NUI: ${C.regNumber}`} data-en={`Reg. no.: ${C.regNumber}`}>NUI: {C.regNumber}</span></>}</span><br /><a href="/support" data-sq="Mbështetja për aplikacionet →" data-en="App support →">Mbështetja për aplikacionet →</a></div></div>
        </div>
        <div class="map-embed" data-embed-src={C.mapsEmbed} data-embed-title="iCode — Google Maps">
          <div class="map-ph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <b data-sq={addressLine('sq')} data-en={addressLine('en')}>{addressLine('sq')}</b>
            <p data-sq="Harta ngarkohet nga Google Maps, i cili vendos cookies të veta." data-en="The map is loaded from Google Maps, which sets its own cookies.">Harta ngarkohet nga Google Maps, i cili vendos cookies të veta.</p>
            <div class="map-actions">
              <button type="button" class="btn btn-primary" data-load-embed data-sq="Shfaq hartën" data-en="Show map">Shfaq hartën</button>
              <a class="btn btn-outline" href={C.mapsUrl} target="_blank" rel="noopener" data-sq="Hap në Google Maps" data-en="Open in Google Maps">Hap në Google Maps</a>
            </div>
          </div>
        </div>
      </div>

      <!-- form -->
      <div class="form-card" data-reveal data-reveal-delay="1">
        <form id="contact-form" onsubmit="return false;">
          <div class="form-row">
            <div class="field"><label data-sq="Emri" data-en="Name">Emri</label><input type="text" required data-sq-ph="Emri yt" data-en-ph="Your name" placeholder="Emri yt"></div>
            <div class="field"><label data-sq="Mbiemri" data-en="Surname">Mbiemri</label><input type="text" data-sq-ph="Mbiemri yt" data-en-ph="Your surname" placeholder="Mbiemri yt"></div>
          </div>
          <div class="form-row">
            <div class="field"><label>Email</label><input type="email" required placeholder="email@shembull.com"></div>
            <div class="field"><label data-sq="Telefon" data-en="Phone">Telefon</label><input type="tel" placeholder="+383 ..."></div>
          </div>
          <div class="field"><label data-sq="Çfarë shërbimi të intereson?" data-en="Which service interests you?">Çfarë shërbimi të intereson?</label>
            <select id="svc-select">
              <option data-sq="Zhvillim Web" data-en="Web Development">Zhvillim Web</option>
              <option data-sq="Aplikacion Mobile" data-en="Mobile App">Aplikacion Mobile</option>
              <option data-sq="E-Commerce" data-en="E-Commerce">E-Commerce</option>
              <option data-sq="Custom Software" data-en="Custom Software">Custom Software</option>
              <option data-sq="UI/UX Design" data-en="UI/UX Design">UI/UX Design</option>
              <option data-sq="Game Engine & 3D" data-en="Game Engine & 3D">Game Engine & 3D</option>
              <option data-sq="Platformë ERP" data-en="ERP Platform">Platformë ERP</option><option data-sq="Sistem POS" data-en="POS System">Sistem POS</option><option data-sq="WMS & OMS" data-en="WMS & OMS">WMS & OMS</option><option data-sq="Integrime AI & Cloud" data-en="AI & Cloud">Integrime AI & Cloud</option>
              <option value="audit" data-sq="Audit falas i sistemit / dyqanit" data-en="Free system / store audit">Audit falas i sistemit / dyqanit</option>
              <option data-sq="Tjetër" data-en="Other">Tjetër</option>
            </select>
          </div>
          <div class="field"><label data-sq="Trego për projektin" data-en="Tell us about the project">Trego për projektin</label><textarea required data-sq-ph="Përshkruaj shkurt idenë, qëllimet dhe afatin..." data-en-ph="Briefly describe the idea, goals and timeline..." placeholder="Përshkruaj shkurt idenë, qëllimet dhe afatin..."></textarea></div>
          <button class="btn btn-primary btn-lg" type="submit" style="width:100%;" data-sq="Dërgo mesazhin" data-en="Send message">Dërgo mesazhin</button>
          <div class="form-note" id="form-note" data-sq="Faleminderit! Mesazhi u dërgua. Të kontaktojmë së shpejti." data-en="Thank you! Your message was sent. We'll contact you shortly.">Faleminderit! Mesazhi u dërgua. Të kontaktojmë së shpejti.</div>
        </form>
      </div>
    </div>
  </div>
</section>

</Base>

<style is:global>
.contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(36px,5vw,72px);align-items:start;}
@media (max-width:880px){.contact-grid{grid-template-columns:1fr;}}
.contact-info-item{display:flex;gap:16px;align-items:flex-start;padding:22px 0;border-bottom:1px solid var(--line);}
.contact-info-item .ci-ico{width:46px;height:46px;border-radius:12px;flex:none;display:grid;place-items:center;background:var(--bg-soft);color:var(--primary);}
.contact-info-item .ci-ico svg{width:22px;height:22px;stroke-width:1.6;}
.contact-info-item b{font-family:var(--ff-head);display:block;margin-bottom:3px;}
.contact-info-item a,.contact-info-item span{color:var(--muted);}
.form-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:clamp(28px,4vw,44px);}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
@media (max-width:520px){.form-row{grid-template-columns:1fr;}}
.form-note{display:none;margin-top:18px;padding:16px 18px;background:#eaf7ef;border:1px solid #bfe6cd;border-radius:13px;color:#12713e;font-weight:600;font-family:var(--ff-head);}
.form-note.show{display:block;}
.map-embed{position:relative;min-height:320px;aspect-ratio:16/10;margin-top:28px;border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;background:var(--bg-soft);}
.map-embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}
.map-embed.loaded .map-ph{display:none;}
.map-ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:24px;text-align:center;}
.map-ph svg{width:34px;height:34px;color:var(--primary);}
.map-ph b{font-family:var(--ff-head);font-weight:600;}
.map-ph p{font-size:.9rem;color:var(--muted);max-width:340px;}
.map-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:6px;}
.map-actions .btn{padding:12px 20px;font-size:.9rem;}
</style>

<script>
(function(){
  try{ if(new URLSearchParams(location.search).get('topic')==='audit'){ var s=document.getElementById('svc-select'); if(s) s.value='audit'; } }catch(e){}
  var f=document.getElementById('contact-form');
  f.addEventListener('submit',function(){
    var note=document.getElementById('form-note');
    note.classList.add('show');
    f.querySelectorAll('input,textarea,select').forEach(function(el){el.value='';});
    setTimeout(function(){note.classList.remove('show');},5000);
  });
})();
</script>
