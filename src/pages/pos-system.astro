---
import Base from '../layouts/Base.astro';
---
<Base
  title="Sistem POS — iCode LLC"
  description="POS offline-first me sinkronizim event-based në ERP — skanim nën 100ms, store-and-forward, ESC/POS, mbyllje arke që poston direkt në financa."
  bodyClass="pos-world"
>

<section class="pos-hero">
  <div class="container-wide"><div class="split" style="align-items:center;">
    <div data-reveal>
      <span class="pos-kicker"><i></i>OFFLINE MODE · SALES CONTINUE</span>
      <h1 data-sq="Arka që s'pyet a ka internet" data-en="The till that doesn't ask if there's internet">Arka që s'pyet a ka internet</h1>
      <p class="lead mt-m" data-sq="Çdo shitje regjistrohet lokalisht si ngjarje e pandryshueshme dhe sinkronizohet në ERP sapo kthehet lidhja — pa dyfishime, pa humbje, pa radhë të bllokuara në orën e pikut." data-en="Every sale is recorded locally as an immutable event and syncs to the ERP the moment the connection returns — no duplicates, no losses, no frozen queues at rush hour.">Çdo shitje regjistrohet lokalisht si ngjarje e pandryshueshme dhe sinkronizohet në ERP sapo kthehet lidhja — pa dyfishime, pa humbje, pa radhë të bllokuara në orën e pikut.</p>
      <div class="btn-row mt-l">
        <a class="btn btn-dark btn-lg" href="/contact" data-sq="Kërko demo" data-en="Request a demo">Kërko demo</a>
        <a class="btn btn-outline btn-lg" href="/erp-platform" data-sq="I lidhur me ERP →" data-en="Wired into the ERP →">I lidhur me ERP →</a>
      </div>
    </div>
    <div data-reveal data-reveal-delay="2">
      <div class="printer-scene">
        <div class="payterm" id="payterm"><span id="pt-amt">0.00 €</span><span id="pt-st">FATURA E HAPUR</span></div>
        <div class="pos-stage">
          <div class="bill" id="bill">
            <div class="mode-tabs"><button class="mtab on" data-mode="market">MARKET</button><button class="mtab" data-mode="rest" data-sq="RESTORANT" data-en="RESTAURANT">RESTORANT</button><span class="mtab mtab-more" data-sq="+ TJERA" data-en="+ MORE">+ TJERA</span></div>
            <div class="mode-note" data-sq="Demo interaktive — klikoji MARKET / RESTORANT për t’i provuar. Ofrojmë edhe POS për hotele, farmaci, servise, bar-kafe etj." data-en="Interactive demo — click MARKET / RESTAURANT to try them. We also offer POS for hotels, pharmacies, workshops, cafés and more.">Demo interaktive — klikoji MARKET / RESTORANT për t’i provuar. Ofrojmë edhe POS për hotele, farmaci, servise, bar-kafe etj.</div>
            <div id="v-rest" hidden>
              <div id="floor-v">
                <div class="bt" data-sq="ZGJIDH TAVOLINËN" data-en="PICK A TABLE">ZGJIDH TAVOLINËN</div>
                <div class="floor">
                  <button class="tseat round" data-tbl="1"><span class="ch c-t"></span><span class="ch c-b"></span><span class="ch c-l"></span><span class="ch c-r"></span><b>T1</b><i class="tt" id="tt-1"></i></button>
                  <button class="tseat sq" data-tbl="2"><span class="ch c-t"></span><span class="ch c-b"></span><span class="ch c-l"></span><span class="ch c-r"></span><b>T2</b><i class="tt" id="tt-2"></i></button>
                </div>
                <div class="ord-empty" data-sq="Kliko tavolinën për të hapur porosinë" data-en="Tap a table to open its order">Kliko tavolinën për të hapur porosinë</div>
              </div>
              <div id="menu-v" hidden>
                <div class="back-row"><button class="backbtn" id="backbtn" aria-label="Back">←</button><div class="bsub" style="margin:0;"><span data-sq="TAVOLINA" data-en="TABLE">TAVOLINA</span> <span id="tbl-lbl">1</span> · OP: BLERTA · <span id="rc-date">--</span></div></div>
                <div class="cat-tabs"><button class="cat on" data-cat="pije" data-sq="PIJE" data-en="DRINKS">PIJE</button><button class="cat" data-cat="ushqim" data-sq="USHQIM" data-en="FOOD">USHQIM</button></div>
                <div class="menu-grid" id="menu-grid"></div>
                <hr style="border:none;border-top:1.5px dashed #bbb;margin:8px 0;" />
                <div class="ord-lines" id="ord-lines"></div>
                <div class="rl big"><span>TOTALI</span><span id="ord-total">0.00 €</span></div>
                <button class="paybtn" id="rest-pay" disabled data-sq="PAGUAJ FATURËN" data-en="PAY THE BILL">PAGUAJ FATURËN</button>
              </div>
            </div>
            <div id="v-market">
              <div class="bt">MARKETI iCode LLC</div>
              <div class="bsub">KASA 01 · OP: BLERTA</div>
              <table class="scan-table"><thead><tr><th data-sq="Barkodi" data-en="Barcode">Barkodi</th><th data-sq="Shifra" data-en="Code">Shifra</th><th data-sq="Emërtimi" data-en="Item">Emërtimi</th><th data-sq="Sasia" data-en="Qty">Sasia</th><th data-sq="Çmimi" data-en="Price">Çmimi</th></tr></thead><tbody id="scan-body"></tbody></table>
              <div class="menu-grid" id="mk-grid"></div>
              <div class="rl big" style="margin-top:10px;"><span>TOTALI</span><span id="mk-total">0.00 €</span></div>
              <button class="paybtn" id="mk-pay" disabled data-sq="F12 · PAGUAJ" data-en="F12 · PAY">F12 · PAGUAJ</button>
            </div>
          </div>
          <div class="fiscal-wrap" id="fwrap">
            <div class="printer"><i></i></div>
            <div class="rslot">
              <div class="receipt receipt2" id="rc2">
                <div class="rfh">KUPON FISKAL</div>
                <div class="rfs" style="text-align:center;">iCode Sh.p.k. · NUI 811-XXX-XXX · Gjilan<br /><span id="rc-ctx">Kasa 01 · Operator: BLERTA · TAVOLINA 1</span></div>
                <hr />
                <div id="rc-items"></div>
                <hr />
                <div class="rl"><span>Baza 18%</span><span id="rc-base">0.00 €</span></div>
                <div class="rl"><span>TVSH 18%</span><span id="rc-tvsh">0.00 €</span></div>
                <div class="rl big"><span>TOTALI</span><span id="rc-total">0.00 €</span></div>
                <div class="rl"><span>PAGUAR: KARTELË ····4921</span><span>APPROVED</span></div>
                <hr />
                <div class="rl rfs"><span>NIVF:</span><span>84F3-1C29-7B0A-4E</span></div>
                <div class="rl rfs"><span>NSLF:</span><span>A1B2C3D4E5F60718</span></div>
                <div class="rqr"><i></i><i class="o"></i><i></i><i></i><i class="o"></i><i></i><i></i><i class="o"></i><i></i><i class="o"></i><i></i><i></i><i class="o"></i><i class="o"></i><i></i><i></i><i class="o"></i><i></i><i class="o"></i><i></i><i></i><i class="o"></i><i class="o"></i><i></i><i class="o"></i><i></i><i class="o"></i><i class="o"></i><i></i><i></i><i class="o"></i><i></i><i></i><i class="o"></i><i></i><i></i><i class="o"></i><i class="o"></i><i></i><i class="o"></i><i></i><i class="o"></i><i></i><i></i><i></i><i class="o"></i><i></i><i class="o"></i><i></i></div>
                <div class="sef" id="sef-st">SEF · KUPON FISKAL I DIGJITALIZUAR</div>
              </div>
            </div>
          </div>
          <div class="pos-cur" id="pos-cur"><svg viewBox="0 0 24 24"><path d="M4 2l16 8-7 2-3 7z" fill="#0e0e10" stroke="#fff" stroke-width="1.4"/></svg></div>
        </div>
      </div>
    </div>
  </div></div>
</section>

<section class="section" style="padding-top:clamp(40px,5vw,70px);">
  <div class="container-wide">
    <div class="pos-stats">
      <div class="pstat" data-reveal><b>&lt; 100 ms</b><span data-sq="Nga skanimi te rreshti në faturë — i matur, jo i premtuar. Ndërfaqja mban ritmin e kasierit më të shpejtë." data-en="Scan-to-line latency — measured, not promised. The UI keeps pace with your fastest cashier.">Nga skanimi te rreshti në faturë — i matur, jo i premtuar. Ndërfaqja mban ritmin e kasierit më të shpejtë.</span></div>
      <div class="pstat" data-reveal data-reveal-delay="1"><b data-sq="0 shitje të humbura" data-en="0 lost sales">0 shitje të humbura</b><span data-sq="Store-and-forward: ngjarjet ruhen në bazën lokale dhe dorëzohen exactly-once me çelësa idempotence." data-en="Store-and-forward: events persist in the local DB and deliver exactly-once with idempotency keys.">Store-and-forward: ngjarjet ruhen në bazën lokale dhe dorëzohen exactly-once me çelësa idempotence.</span></div>
      <div class="pstat" data-reveal data-reveal-delay="2"><b data-sq="5 min mbyllje" data-en="5-min closing">5 min mbyllje</b><span data-sq="Z-raporti dhe numërimi i verbër i arkës — diferencat evidentohen aty për aty dhe postohen direkt në financa." data-en="Z-report and blind cash count — variances surface on the spot and post straight to finance.">Z-raporti dhe numërimi i verbër i arkës — diferencat evidentohen aty për aty dhe postohen direkt në financa.</span></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container-wide">
    <div class="sec-head" data-reveal>
      <span class="eyebrow" data-sq="Si funksionon offline" data-en="How offline works">Si funksionon offline</span>
      <h2 data-sq="Ngjarje, jo gjendje — prandaj s'prishet kurrë" data-en="Events, not state — that's why it never breaks">Ngjarje, jo gjendje — prandaj s'prishet kurrë</h2>
    </div>
    <div class="sync-flow" data-reveal>
      <div class="sf-node"><span class="tagm">TERMINAL</span><b data-sq="Regjistër lokal ngjarjesh" data-en="Local event journal">Regjistër lokal ngjarjesh</b><p data-sq="Çdo shitje, kthim e anulim shkruhet si ngjarje e renditur në bazën lokale — burimi i së vërtetës i terminalit edhe pa rrjet." data-en="Every sale, return and void is written as an ordered event in the local DB — the terminal's source of truth even with no network.">Çdo shitje, kthim e anulim shkruhet si ngjarje e renditur në bazën lokale — burimi i së vërtetës i terminalit edhe pa rrjet.</p></div>
      <div class="sf-arrow">→</div>
      <div class="sf-node"><span class="tagm">SYNC ENGINE</span><b data-sq="Dorëzim exactly-once" data-en="Exactly-once delivery">Dorëzim exactly-once</b><p data-sq="Radha store-and-forward me çelësa idempotence dhe backoff eksponencial — ritenton vetë, pa dyfishuar asnjë faturë." data-en="A store-and-forward queue with idempotency keys and exponential backoff — retries itself without ever duplicating a receipt.">Radha store-and-forward me çelësa idempotence dhe backoff eksponencial — ritenton vetë, pa dyfishuar asnjë faturë.</p></div>
      <div class="sf-arrow">→</div>
      <div class="sf-node"><span class="tagm">ERP</span><b data-sq="Postim automatik" data-en="Automatic posting">Postim automatik</b><p data-sq="Shitjet zbresin stokun — në gastronomi edhe përbërësit sipas normativave (recetave) — mbyllja e arkës poston vetë në kontabilitet, çmimet e reja kthehen te terminalet — një cikël i vetëm i besueshëm." data-en="Sales decrement stock — in hospitality, ingredients too, per the recipe norms — till closings post straight into accounting, new prices flow back to terminals — one dependable loop.">Shitjet zbresin stokun — në gastronomi edhe përbërësit sipas normativave (recetave) — mbyllja e arkës poston vetë në kontabilitet, çmimet e reja kthehen te terminalet — një cikël i vetëm i besueshëm.</p></div>
    </div>
  </div>
</section>

<section class="section" style="background:#f1ede3;">
  <div class="container-wide">
    <div class="sec-head" data-reveal>
      <span class="eyebrow" data-sq="Pajisjet & fiskalizimi" data-en="Hardware & fiscalisation">Pajisjet & fiskalizimi</span>
      <h2 data-sq="Flet me çdo pajisje të banakut" data-en="Speaks to everything on the counter">Flet me çdo pajisje të banakut</h2>
    </div>
    <div class="hw-grid">
      <div class="hw" data-reveal><span class="hm">ESC/POS</span><b data-sq="Printerë faturash" data-en="Receipt printers">Printerë faturash</b><p data-sq="Printim direkt ESC/POS me shabllone të konfigurueshme — logo, TVSH, QR fiskal — dhe rezervë në printer të dytë." data-en="Direct ESC/POS printing with configurable templates — logo, VAT, fiscal QR — and failover to a second printer.">Printim direkt ESC/POS me shabllone të konfigurueshme — logo, TVSH, QR fiskal — dhe rezervë në printer të dytë.</p></div>
      <div class="hw" data-reveal><span class="hm">HID / SERIAL</span><b data-sq="Skanerë & peshore" data-en="Scanners & scales">Skanerë & peshore</b><p data-sq="Barcode 1D/2D, peshore me protokoll serial për artikuj me peshë, dhe kodifikim i brendshëm për artikuj pa barkod." data-en="1D/2D barcodes, serial-protocol scales for weighed items, and internal codes for unbarcoded products.">Barcode 1D/2D, peshore me protokoll serial për artikuj me peshë, dhe kodifikim i brendshëm për artikuj pa barkod.</p></div>
      <div class="hw" data-reveal><span class="hm">TERMINAL API</span><b data-sq="Terminale pagese" data-en="Payment terminals">Terminale pagese</b><p data-sq="Integrim protokolar me terminalet bankare — shuma kalon vetë, statusi kthehet në faturë, pa shtypje të dyfishtë manuale." data-en="Protocol-level integration with bank terminals — the amount passes automatically, the status returns to the receipt, no double keying.">Integrim protokolar me terminalet bankare — shuma kalon vetë, statusi kthehet në faturë, pa shtypje të dyfishtë manuale.</p></div>
      <div class="hw" data-reveal><span class="hm">FISCAL READY</span><b data-sq="Fiskalizimi" data-en="Fiscalisation">Fiskalizimi</b><p data-sq="Arkitekturë e gatshme për fiskalizim — numërim rendor i pandërprerë, QR në faturë dhe raportim sipas rregullativës lokale." data-en="Fiscalisation-ready architecture — unbroken sequential numbering, QR on the receipt and reporting per local regulation.">Arkitekturë e gatshme për fiskalizim — numërim rendor i pandërprerë, QR në faturë dhe raportim sipas rregullativës lokale.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:880px;">
    <div class="sec-head" data-reveal>
      <span class="eyebrow" data-sq="Operimi ditor" data-en="Daily operations">Operimi ditor</span>
      <h2 data-sq="Kontroll i plotë mbi arkën dhe stafin" data-en="Full control over till and staff">Kontroll i plotë mbi arkën dhe stafin</h2>
    </div>
    <div data-reveal>
      <div class="zline"><b data-sq="Ndërrime & role" data-en="Shifts & roles">Ndërrime & role</b><span data-sq="Hapje/mbyllje ndërrimi për operator, leje granulare (zbritje, anulime, kthime) me PIN ose kartelë" data-en="Per-operator shift open/close, granular permissions (discounts, voids, returns) via PIN or card">Hapje/mbyllje ndërrimi për operator, leje granulare (zbritje, anulime, kthime) me PIN ose kartelë</span></div>
      <div class="zline"><b data-sq="Numërim i verbër" data-en="Blind count">Numërim i verbër</b><span data-sq="Kasieri numëron pa e parë shifrën e pritur — diferencat regjistrohen me arsye dhe auditohen" data-en="The cashier counts without seeing the expected figure — variances log with a reason and are audited">Kasieri numëron pa e parë shifrën e pritur — diferencat regjistrohen me arsye dhe auditohen</span></div>
      <div class="zline"><b>Z-Report</b><span data-sq="Mbyllja e ditës me përmbledhje për mënyra pagese, TVSH e kategori — postohet automatikisht në financa" data-en="End-of-day summary by tender, VAT and category — posts automatically to finance">Mbyllja e ditës me përmbledhje për mënyra pagese, TVSH e kategori — postohet automatikisht në financa</span></div>
      <div class="zline"><b data-sq="Audit i plotë" data-en="Full audit trail">Audit i plotë</b><span data-sq="Çdo veprim i gjurmueshëm te operatori, terminali dhe koha — i pandryshueshëm, i gatshëm për kontroll" data-en="Every action traceable to operator, terminal and time — immutable, inspection-ready">Çdo veprim i gjurmueshëm te operatori, terminali dhe koha — i pandryshueshëm, i gatshëm për kontroll</span></div>
      <div class="zline"><b data-sq="Multi-lokacion" data-en="Multi-location">Multi-lokacion</b><span data-sq="Çmime e promocione per lokacion nga qendra; terminale të reja provizionohen me një konfigurim" data-en="Per-location prices and promotions from HQ; new terminals provision from a single config">Çmime e promocione per lokacion nga qendra; terminale të reja provizionohen me një konfigurim</span></div>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container-wide">
    <p class="center" style="font-family:var(--ff-head);font-weight:600;color:var(--muted);margin-bottom:36px;" data-reveal data-sq="Biznese që shesin çdo ditë me POS-in tonë" data-en="Businesses selling every day on our POS">Biznese që shesin çdo ditë me POS-in tonë</p>
    <div class="marquee" data-reveal>
      <div class="marquee-track"><span class="logo-item">ALDI Group</span><span class="logo-item">Basimetzg</span><span class="logo-item">Timoni Garden</span><span class="logo-item">Arena Fitness &amp; Healthy food</span><span class="logo-item">Qumshtorja KABI</span><span class="logo-item">Resort Planet</span><span class="logo-item">Durrësi SHPK</span><span class="logo-item">iData+</span><span class="logo-item">Aqua Di Polo</span><span class="logo-item">Astra Market</span><span class="logo-item">ALDI Group</span><span class="logo-item">Basimetzg</span><span class="logo-item">Timoni Garden</span><span class="logo-item">Arena Fitness &amp; Healthy food</span><span class="logo-item">Qumshtorja KABI</span><span class="logo-item">Resort Planet</span><span class="logo-item">Durrësi SHPK</span><span class="logo-item">iData+</span><span class="logo-item">Aqua Di Polo</span><span class="logo-item">Astra Market</span></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container-wide">
    <div class="cta-band" data-reveal style="background:#0e0e10;">
      <h2 data-sq="Provoje me internetin e fikur" data-en="Try it with the internet switched off">Provoje me internetin e fikur</h2>
      <p data-sq="Në demo e shkëputim rrjetin dhe vazhdojmë të shesim — pastaj e sheh sinkronizimin live në ERP." data-en="In the demo we pull the network and keep selling — then you watch it sync live into the ERP.">Në demo e shkëputim rrjetin dhe vazhdojmë të shesim — pastaj e sheh sinkronizimin live në ERP.</p>
      <div class="btn-row" style="justify-content:center;margin-top:32px;">
        <a class="btn btn-primary btn-lg" href="/contact" data-sq="Kërko demo" data-en="Request a demo">Kërko demo</a>
        <a class="btn btn-outline-light btn-lg" href="tel:+38348331333">+383 48 331 333</a>
      </div>
    </div>
  </div>
</section>

</Base>

<style is:global>
body.pos-world{background:#faf7f0;}
.pos-mono{font-family:ui-monospace,'SF Mono','Cascadia Code',Menlo,Consolas,monospace;}
.pos-hero{background:#faf7f0;padding-block:clamp(64px,8vw,110px);position:relative;overflow:hidden;}
.pos-hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(14,14,16,.06) 1px,transparent 1px);background-size:22px 22px;}
.pos-hero .container-wide{position:relative;}
.pos-kicker{display:inline-flex;align-items:center;gap:9px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.78rem;letter-spacing:.12em;background:#0e0e10;color:#7dffa8;padding:9px 16px;border-radius:6px;margin-bottom:24px;}
.pos-kicker i{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:posBlink 2s infinite;}
@keyframes posBlink{50%{opacity:.35;}}
@media (prefers-reduced-motion:reduce){.pos-kicker i{animation:none;}}
.receipt{background:#fff;width:min(360px,100%);margin-inline:auto;padding:28px 26px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.82rem;line-height:1.7;color:#222;box-shadow:0 30px 60px rgba(14,14,16,.16);position:relative;transform:rotate(1.5deg);}
.receipt::before,.receipt::after{content:"";position:absolute;left:0;right:0;height:10px;background:radial-gradient(circle at 10px -4px,transparent 8px,#fff 8px);background-size:20px 12px;}
.receipt::before{top:-9px;transform:rotate(180deg);}
.receipt::after{bottom:-9px;}
.receipt .rl{display:flex;justify-content:space-between;gap:12px;}
.receipt hr{border:none;border-top:1.5px dashed #bbb;margin:12px 0;}
.receipt .rt{text-align:center;font-weight:700;letter-spacing:.15em;}
.receipt .big{font-size:1.05rem;font-weight:700;}
.receipt .led{display:flex;justify-content:space-between;align-items:center;background:#0e0e10;color:#7dffa8;padding:8px 12px;border-radius:5px;margin-top:12px;font-size:.72rem;letter-spacing:.1em;}
.pos-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2vw,28px);}
@media (max-width:760px){.pos-stats{grid-template-columns:1fr;}}
.pstat{border:2px solid #0e0e10;border-radius:16px;padding:30px 28px;background:#fff;box-shadow:6px 6px 0 #0e0e10;}
.pstat b{font-family:var(--ff-head);font-size:clamp(1.7rem,2.6vw,2.4rem);letter-spacing:-.02em;display:block;}
.pstat span{color:var(--muted);font-size:.92rem;}
.sync-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:14px;align-items:center;}
@media (max-width:820px){.sync-flow{grid-template-columns:1fr;}.sync-flow .sf-arrow{transform:rotate(90deg);justify-self:center;}}
.sf-node{border:2px solid #0e0e10;border-radius:14px;background:#fff;padding:22px;}
.sf-node b{font-family:var(--ff-head);display:block;margin-bottom:8px;}
.sf-node p{font-size:.85rem;color:var(--muted);line-height:1.55;}
.sf-node .tagm{display:inline-block;font-family:ui-monospace,Menlo,monospace;font-size:.68rem;background:#0e0e10;color:#7dffa8;padding:3px 8px;border-radius:4px;margin-bottom:10px;letter-spacing:.08em;}
.sf-arrow{font-size:1.4rem;color:#0e0e10;text-align:center;}
.hw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
@media (max-width:900px){.hw-grid{grid-template-columns:repeat(2,1fr);}}
.hw{border:1.5px solid var(--line-2);border-radius:14px;padding:24px;background:#fff;transition:transform .25s var(--ease),box-shadow .25s;}
.hw:hover{transform:translateY(-4px);box-shadow:6px 6px 0 #0e0e10;border-color:#0e0e10;}
.hw b{font-family:var(--ff-head);display:block;margin-bottom:8px;font-size:1rem;}
.hw p{font-size:.84rem;color:var(--muted);line-height:1.55;}
.hw .hm{font-family:ui-monospace,Menlo,monospace;font-size:.66rem;letter-spacing:.1em;color:#16a34a;display:block;margin-bottom:10px;}
.zline{display:flex;justify-content:space-between;gap:14px;padding:16px 4px;border-bottom:1.5px dashed var(--line-2);font-size:.95rem;align-items:baseline;}
.zline b{font-family:var(--ff-head);white-space:nowrap;}
.zline span{color:var(--muted);text-align:right;}
a{color:inherit;}a:hover{color:var(--primary);}
.printer-scene{width:min(360px,100%);margin-inline:auto;position:relative;}
.payterm{display:flex;justify-content:space-between;align-items:center;background:#0e0e10;color:#fff;border-radius:12px;padding:14px 18px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.82rem;margin-bottom:14px;letter-spacing:.06em;}
.payterm #pt-st{color:#febc2e;transition:color .3s;}
.payterm.ok #pt-st{color:#7dffa8;}
.printer{height:28px;background:linear-gradient(#2c2c31,#0e0e10);border-radius:10px 10px 5px 5px;position:relative;z-index:3;box-shadow:0 8px 20px rgba(14,14,16,.35);}
.printer i{position:absolute;left:14px;right:14px;bottom:5px;height:4px;background:#000;border-radius:2px;}
.rslot{overflow:hidden;padding:0 12px 6px;margin-top:-2px;}
.receipt2{transform:translateY(-104%);margin:0 auto;}
.receipt2.printing{transition:transform 3.6s cubic-bezier(.25,.6,.35,1);transform:translateY(0);}
.rqr{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;width:78px;margin:10px auto 6px;}
.rqr i{aspect-ratio:1;background:#111;}
.rqr i.o{background:transparent;}
.sef{text-align:center;font-size:.64rem;letter-spacing:.12em;font-weight:700;}
.sef.ok2{color:#16a34a;}
.bill .rl{display:flex;justify-content:space-between;gap:12px;}
.pos-stage{position:relative;min-height:680px;}
.bill{position:absolute;left:50%;top:0;transform:translateX(-50%);width:min(320px,100%);background:#fff;border:1.5px solid var(--line-2);border-radius:14px;box-shadow:0 24px 50px rgba(14,14,16,.14);padding:22px 22px 18px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.8rem;line-height:1.75;color:#222;transition:opacity .5s var(--ease),transform .5s var(--ease);}
.bill.gone{opacity:0;transform:translateX(-50%) translateY(-18px);pointer-events:none;}
.bill .bt{text-align:center;font-weight:700;letter-spacing:.12em;margin-bottom:6px;}
.bill .bsub{text-align:center;font-size:.62rem;color:#888;letter-spacing:.08em;margin-bottom:10px;}
.paybtn{width:100%;margin-top:14px;background:#0e0e10;color:#fff;border-radius:10px;padding:13px;font-family:var(--ff-head);font-weight:700;font-size:.8rem;letter-spacing:.08em;border:none;cursor:pointer;transition:transform .15s,background .3s;}
.paybtn.pressed{transform:scale(.95);background:#16a34a;}
.paybtn.pulse{animation:payPulse 2s infinite;}
@keyframes payPulse{0%,100%{box-shadow:0 0 0 0 rgba(22,163,74,.55);}50%{box-shadow:0 0 0 14px rgba(22,163,74,0);}}
@media (prefers-reduced-motion:reduce){.paybtn.pulse{animation:none;}}
.paybtn:disabled{opacity:.45;cursor:default;}
.tbl-row{display:flex;gap:8px;margin:10px 0 8px;}
.tbl{flex:1;font-family:var(--ff-head);font-weight:700;font-size:.72rem;letter-spacing:.06em;padding:8px 0;border:1.5px solid #e0e0e4;border-radius:8px;background:#fafafa;cursor:pointer;transition:.2s;color:#555;}
.tbl.on{background:#0e0e10;color:#7dffa8;border-color:#0e0e10;}
.menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 6px;}
.mi{text-align:left;border:1.5px solid #e4e4e8;border-radius:10px;padding:8px 11px;background:#fff;cursor:pointer;transition:transform .15s,border-color .2s;font-family:inherit;font-size:.72rem;line-height:1.5;}
.mi:hover{border-color:#0e0e10;}
.mi.hit{transform:scale(.94);border-color:#16a34a;}
.mi b{display:block;font-size:.74rem;color:#111;}
.mi .mc{display:block;font-size:.54rem;letter-spacing:.12em;font-weight:700;}
.mi .mp{color:#666;}
.mc.pije{color:#1b4dff;}.mc.pizza{color:#ff5a1f;}.mc.steak{color:#c0392b;}.mc.sallat{color:#16a34a;}
.ord-lines .rl{cursor:pointer;}
.ord-lines .rl:hover{color:#c0392b;}
.ord-empty{color:#999;font-size:.68rem;text-align:center;padding:4px 0 6px;}
.mode-tabs{display:flex;gap:8px;margin-bottom:12px;}
.mtab{flex:1;font-family:var(--ff-head);font-weight:700;font-size:.72rem;letter-spacing:.08em;padding:10px 0;border:1.5px solid #e0e0e4;border-radius:10px;background:#fafafa;color:#555;cursor:pointer;transition:.2s;}
.mtab.on{background:#0e0e10;color:#7dffa8;border-color:#0e0e10;}
.mtab[data-mode]{position:relative;}
.mtab[data-mode]:not(.on){animation:tabHint 3.2s var(--ease) infinite;}
.mtab[data-mode]:not(.on)::after{content:'';position:absolute;top:-4px;right:-4px;width:9px;height:9px;border-radius:50%;background:#1b4dff;animation:tabDot 1.8s infinite;}
@keyframes tabHint{0%,72%,100%{transform:translateY(0);border-color:#e0e0e4;box-shadow:none;}80%{transform:translateY(-3px);border-color:#1b4dff;box-shadow:0 6px 16px rgba(27,77,255,.16);}90%{transform:translateY(0);}}
@keyframes tabDot{0%,100%{box-shadow:0 0 0 0 rgba(27,77,255,.45);}50%{box-shadow:0 0 0 6px rgba(27,77,255,0);}}
@media (prefers-reduced-motion:reduce){.mtab[data-mode]:not(.on){animation:none;}.mtab[data-mode]:not(.on)::after{animation:none;}}
.mtab-more{flex:0 0 auto;display:flex;align-items:center;padding:10px 11px;font-size:.58rem;color:#888;background:#fff;border-style:dashed;cursor:default;}
.mtab-more:hover{border-color:#e0e0e4;color:#888;}
.mode-note{font-family:var(--ff-head);font-size:.58rem;color:#999;text-align:center;margin:-4px 0 12px;letter-spacing:.02em;}
.floor{display:flex;justify-content:center;gap:44px;padding:34px 0 30px;}
.tseat{position:relative;width:92px;height:92px;background:#fff;border:2px solid #0e0e10;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-family:var(--ff-head);font-weight:800;font-size:1rem;transition:transform .2s,background .2s,color .2s;box-shadow:4px 4px 0 #0e0e10;}
.tseat.round{border-radius:50%;}.tseat.sq{border-radius:18px;}
.tseat:hover{transform:translateY(-3px);background:#0e0e10;color:#7dffa8;}
.tseat .ch{position:absolute;background:#e2e2e6;border:1.5px solid #bbb;border-radius:6px;}
.ch.c-t{width:34px;height:12px;top:-22px;left:50%;transform:translateX(-50%);}
.ch.c-b{width:34px;height:12px;bottom:-22px;left:50%;transform:translateX(-50%);}
.ch.c-l{width:12px;height:34px;left:-22px;top:50%;transform:translateY(-50%);}
.ch.c-r{width:12px;height:34px;right:-22px;top:50%;transform:translateY(-50%);}
.tseat .tt{font-style:normal;font-size:.56rem;font-weight:700;color:#16a34a;min-height:.8em;}
.tseat:hover .tt{color:#7dffa8;}
.back-row{display:flex;align-items:center;gap:10px;margin:2px 0 10px;}
.backbtn{width:30px;height:30px;flex:none;border:1.5px solid #ddd;border-radius:8px;background:#fff;cursor:pointer;font-size:.9rem;line-height:1;transition:.2s;}
.backbtn:hover{border-color:#0e0e10;}
.cat-tabs{display:flex;gap:8px;margin:0 0 10px;}
.cat{flex:1;font-family:var(--ff-head);font-weight:700;font-size:.66rem;letter-spacing:.08em;padding:8px 0;border:1.5px solid #e0e0e4;border-radius:8px;background:#fafafa;color:#555;cursor:pointer;transition:.2s;}
.cat.on{background:#1b4dff;color:#fff;border-color:#1b4dff;}
.scan-table{width:100%;border-collapse:collapse;font-size:.6rem;margin:6px 0 10px;}
.scan-table th{font-size:.52rem;letter-spacing:.05em;text-align:left;border-bottom:1.5px solid #111;padding:4px 3px;}
.scan-table td{padding:4px 3px;border-bottom:1px dashed #e0e0e4;white-space:nowrap;}
.scan-table th:nth-child(4),.scan-table td:nth-child(4),.scan-table th:nth-child(5),.scan-table td:nth-child(5){text-align:right;}
.scan-table td.nm{max-width:82px;overflow:hidden;text-overflow:ellipsis;}
.scan-table tr.hit td{animation:scanFlash .6s;}
@keyframes scanFlash{from{background:#d7f8e3;}}
.sc-empty td{color:#999;text-align:center !important;padding:10px 3px;}
.bc{display:block;width:44px;height:13px;margin-bottom:4px;background:repeating-linear-gradient(90deg,#111 0 2px,transparent 2px 4px,#111 4px 5px,transparent 5px 8px);}
.mki .mcode{display:block;font-size:.54rem;color:#888;}
.pos-cur{display:none !important;}
.fiscal-wrap{pointer-events:none;}
.fiscal-wrap{position:absolute;inset:0;opacity:0;transition:opacity .4s;}
.fiscal-wrap.on{opacity:1;}
.rfh{text-align:center;font-weight:700;letter-spacing:.14em;border:1.5px solid #111;border-radius:4px;padding:3px 0;margin-bottom:8px;font-size:.72rem;}
.rfs{font-size:.6rem;color:#555;}
.pos-cur{position:absolute;left:74%;top:82%;z-index:9;width:22px;height:22px;transition:left .85s cubic-bezier(.55,0,.25,1),top .85s cubic-bezier(.55,0,.25,1);filter:drop-shadow(0 3px 6px rgba(0,0,0,.35));}
.pos-cur.click{animation:ecClick2 .3s;}
@keyframes ecClick2{40%{transform:scale(.7);}}
@media (prefers-reduced-motion:reduce){.pos-cur{display:none;}.bill{display:none;}.fiscal-wrap{opacity:1;}}
@media (prefers-reduced-motion:reduce){.receipt2{transform:none;}.receipt2.printing{transition:none;}}
.receipt .rl.new{animation:rlIn .45s var(--ease);}
@keyframes rlIn{from{opacity:0;transform:translateY(5px);}}
.pos-world .eyebrow{font-family:ui-monospace,Menlo,Consolas,monospace;background:#0e0e10;color:#7dffa8;padding:7px 13px;border-radius:6px;letter-spacing:.14em;font-size:.7rem;text-transform:uppercase;}
</style>

<script>
(function(){
  var rc=document.getElementById('rc2'), bill=document.getElementById('bill'); if(!rc) return;
  var d=new Date();
  document.getElementById('rc-date').textContent=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');
  var pt=document.getElementById('payterm'), st=document.getElementById('pt-st'), sef=document.getElementById('sef-st'), fw=document.getElementById('fwrap');
  var ptAmt=document.getElementById('pt-amt');
  var vRest=document.getElementById('v-rest'), vMarket=document.getElementById('v-market');
  var floorV=document.getElementById('floor-v'), menuV=document.getElementById('menu-v');
  var menu=document.getElementById('menu-grid'), ordEl=document.getElementById('ord-lines'), totEl=document.getElementById('ord-total');
  var restPay=document.getElementById('rest-pay'), mkPay=document.getElementById('mk-pay');
  var mkGrid=document.getElementById('mk-grid'), scanBody=document.getElementById('scan-body'), mkTot=document.getElementById('mk-total');
  var tblLbl=document.getElementById('tbl-lbl');
  function L(){try{return localStorage.getItem('icode-lang')||'sq';}catch(e){return 'sq';}}
  function F(n){return n.toFixed(2)+' €';}
  /* ---- data ---- */
  var CAT={pije:['PIJE','DRINKS'],ushqim:['USHQIM','FOOD']};
  var P=[
    {id:'uje', sq:'Ujë 0.5L', en:'Water 0.5L', c:'pije', p:1.00},
    {id:'caffe', sq:'Caffe', en:'Coffee', c:'pije', p:1.50},
    {id:'cola', sq:'Coca-Cola', en:'Coca-Cola', c:'pije', p:1.50},
    {id:'birre', sq:'Birrë', en:'Beer', c:'pije', p:2.50},
    {id:'vere', sq:'Verë (gotë)', en:'Wine (glass)', c:'pije', p:3.50},
    {id:'pepe', sq:'Pizza Peperoni', en:'Pepperoni Pizza', c:'ushqim', p:7.00},
    {id:'biftek', sq:'Biftek', en:'Steak', c:'ushqim', p:19.00},
    {id:'cezar', sq:'Sallatë Cezar', en:'Caesar Salad', c:'ushqim', p:5.99},
    {id:'trad', sq:'Tavë Tradicionale', en:'Traditional Casserole', c:'ushqim', p:6.50}
  ];
  var M=[
    {id:'buke', sq:'Bukë e freskët', en:'Fresh bread', bc:'8600100010017', code:'1001', p:0.60},
    {id:'qumesht', sq:'Qumësht KABI 1L', en:'KABI milk 1L', bc:'8600100010024', code:'1002', p:1.20},
    {id:'veze', sq:'Vezë 10 copë', en:'Eggs, 10pc', bc:'8600100010031', code:'1003', p:2.40},
    {id:'miell', sq:'Miell 1kg', en:'Flour 1kg', bc:'8600100010048', code:'1004', p:1.10},
    {id:'cola15', sq:'Coca-Cola 1.5L', en:'Coca-Cola 1.5L', bc:'8600100010055', code:'1005', p:1.80},
    {id:'cokollate', sq:'Çokollatë', en:'Chocolate', bc:'8600100010062', code:'1006', p:1.50}
  ];
  var byId={}; P.concat(M).forEach(function(x){byId[x.id]=x;});
  /* ---- state ---- */
  var mode='market', cat='pije', tbl=null, busy=false;
  var orders={1:{},2:{}};
  var cart={}, cartOrder=[];
  /* ---- beep ---- */
  var AC=null;
  function beep(){
    try{
      AC=AC||new (window.AudioContext||window.webkitAudioContext)();
      var o=AC.createOscillator(), g=AC.createGain();
      o.type='square'; o.frequency.value=1400;
      g.gain.setValueAtTime(.1,AC.currentTime);
      g.gain.exponentialRampToValueAtTime(.0001,AC.currentTime+.09);
      o.connect(g); g.connect(AC.destination);
      o.start(); o.stop(AC.currentTime+.1);
    }catch(e){}
  }
  function doneBeep(){
    try{
      AC=AC||new (window.AudioContext||window.webkitAudioContext)();
      [880,1320].forEach(function(f,i){
        var o=AC.createOscillator(), g=AC.createGain(), t=AC.currentTime+i*.12;
        o.type='square'; o.frequency.value=f;
        g.gain.setValueAtTime(.09,t);
        g.gain.exponentialRampToValueAtTime(.0001,t+.11);
        o.connect(g); g.connect(AC.destination);
        o.start(t); o.stop(t+.12);
      });
    }catch(e){}
  }
  /* ---- builders ---- */
  function buildMenu(){
    var sq=L()==='sq';
    menu.innerHTML=P.filter(function(x){return x.c===cat;}).map(function(x){
      return '<button class="mi" data-id="'+x.id+'"><span class="mc '+(x.c==='pije'?'pije':'steak')+'" data-sq="'+CAT[x.c][0]+'" data-en="'+CAT[x.c][1]+'">'+(sq?CAT[x.c][0]:CAT[x.c][1])+'</span><b data-sq="'+x.sq+'" data-en="'+x.en+'">'+(sq?x.sq:x.en)+'</b><span class="mp">'+F(x.p)+'</span></button>';
    }).join('');
  }
  mkGrid.innerHTML=M.map(function(x){
    return '<button class="mi mki" data-id="'+x.id+'"><span class="bc"></span><b data-sq="'+x.sq+'" data-en="'+x.en+'">'+x.sq+'</b><span class="mcode">'+x.bc+'</span><span class="mp">'+F(x.p)+'</span></button>';
  }).join('');
  /* ---- totals ---- */
  function restTotal(){ if(tbl==null) return 0; var t=0,o=orders[tbl]; for(var k in o){t+=o[k]*byId[k].p;} return t; }
  function mkTotal(){ var t=0; cartOrder.forEach(function(k){t+=cart[k]*byId[k].p;}); return t; }
  function activeTotal(){ return mode==='rest' ? restTotal() : mkTotal(); }
  /* ---- renders ---- */
  function renderFloor(){
    [1,2].forEach(function(n){
      var t=0,o=orders[n]; for(var k in o){t+=o[k]*byId[k].p;}
      document.getElementById('tt-'+n).textContent = t>0 ? F(t) : '';
    });
  }
  function renderOrder(){
    var sq=L()==='sq', rows='';
    if(tbl!=null){ var o=orders[tbl];
      for(var k in o){ if(o[k]>0){ var x=byId[k];
        rows+='<div class="rl new" data-id="'+k+'"><span data-sq="'+o[k]+'× '+x.sq+'" data-en="'+o[k]+'× '+x.en+'">'+o[k]+'× '+(sq?x.sq:x.en)+'</span><span>'+F(o[k]*x.p)+'</span></div>';
      }}
    }
    ordEl.innerHTML = rows || '<div class="ord-empty" data-sq="Shto produkte nga menyja…" data-en="Add products from the menu…">'+(sq?'Shto produkte nga menyja…':'Add products from the menu…')+'</div>';
    totEl.textContent=F(restTotal());
  }
  function renderScan(){
    var sq=L()==='sq';
    scanBody.innerHTML = cartOrder.length ? cartOrder.map(function(k){
      var x=byId[k];
      return '<tr data-id="'+k+'"><td>…'+x.bc.slice(-4)+'</td><td>'+x.code+'</td><td class="nm" data-sq="'+x.sq+'" data-en="'+x.en+'">'+(sq?x.sq:x.en)+'</td><td>'+cart[k]+'</td><td>'+F(cart[k]*x.p)+'</td></tr>';
    }).join('') : '<tr class="sc-empty"><td colspan="5" data-sq="Kliko produktet poshtë për t’i skanuar…" data-en="Tap products below to scan them…">'+(sq?'Kliko produktet poshtë për t’i skanuar…':'Tap products below to scan them…')+'</td></tr>';
    mkTot.textContent=F(mkTotal());
  }
  function syncTerm(){
    var sq=L()==='sq', t=activeTotal();
    ptAmt.textContent=F(t);
    restPay.disabled = busy || mode!=='rest' || restTotal()===0;
    restPay.classList.toggle('pulse', !busy && mode==='rest' && restTotal()>0);
    mkPay.disabled = busy || mode!=='market' || mkTotal()===0;
    mkPay.classList.toggle('pulse', !busy && mode==='market' && mkTotal()>0);
    if(busy) return;
    if(mode==='rest'){
      if(tbl==null) st.textContent = sq?'ZGJIDH TAVOLINËN':'PICK A TABLE';
      else st.textContent = restTotal()>0 ? (sq?'FATURA E HAPUR':'BILL OPEN') : (sq?'ZGJIDH PRODUKTET':'PICK PRODUCTS');
    } else {
      st.textContent = mkTotal()>0 ? (sq?'FATURA E HAPUR':'BILL OPEN') : (sq?'SKANO PRODUKTET':'SCAN PRODUCTS');
    }
  }
  function renderAll(){ renderFloor(); renderOrder(); renderScan(); syncTerm(); }
  /* ---- receipt ---- */
  function fillReceipt(){
    var sq=L()==='sq', rows='', t=activeTotal();
    if(mode==='rest'){ var o=orders[tbl];
      for(var k in o){ if(o[k]>0){ var x=byId[k]; rows+='<div class="rl"><span>'+o[k]+'× '+(sq?x.sq:x.en)+'</span><span>'+F(o[k]*x.p)+'</span></div>'; }}
      document.getElementById('rc-ctx').textContent='Kasa 01 · Operator: BLERTA · '+(sq?'TAVOLINA ':'TABLE ')+tbl;
    } else {
      cartOrder.forEach(function(k){ var x=byId[k]; rows+='<div class="rl"><span>'+cart[k]+'× '+(sq?x.sq:x.en)+'</span><span>'+F(cart[k]*x.p)+'</span></div>'; });
      document.getElementById('rc-ctx').textContent='MARKETI iCode LLC · Kasa 01 · OP: BLERTA';
    }
    document.getElementById('rc-items').innerHTML=rows;
    var base=t/1.18;
    document.getElementById('rc-base').textContent=F(base);
    document.getElementById('rc-tvsh').textContent=F(t-base);
    document.getElementById('rc-total').textContent=F(t);
  }
  /* ---- events ---- */
  document.querySelector('.mode-tabs').addEventListener('click', function(e){
    var b=e.target.closest('.mtab'); if(!b||busy||!b.getAttribute('data-mode')) return;
    mode=b.getAttribute('data-mode');
    this.querySelectorAll('.mtab').forEach(function(x){x.classList.toggle('on', x===b);});
    vRest.hidden = mode!=='rest'; vMarket.hidden = mode!=='market';
    renderAll();
  });
  floorV.addEventListener('click', function(e){
    var b=e.target.closest('.tseat'); if(!b||busy) return;
    tbl=+b.getAttribute('data-tbl'); tblLbl.textContent=tbl;
    floorV.hidden=true; menuV.hidden=false;
    buildMenu(); renderAll();
  });
  document.getElementById('backbtn').addEventListener('click', function(){
    if(busy) return;
    menuV.hidden=true; floorV.hidden=false; tbl=null; renderAll();
  });
  document.querySelector('.cat-tabs').addEventListener('click', function(e){
    var b=e.target.closest('.cat'); if(!b||busy) return;
    cat=b.getAttribute('data-cat');
    this.querySelectorAll('.cat').forEach(function(x){x.classList.toggle('on', x===b);});
    buildMenu();
  });
  menu.addEventListener('click', function(e){
    var b=e.target.closest('.mi'); if(!b||busy||tbl==null) return;
    var id=b.getAttribute('data-id');
    orders[tbl][id]=(orders[tbl][id]||0)+1;
    b.classList.add('hit'); setTimeout(function(){b.classList.remove('hit');},180);
    renderOrder(); syncTerm();
  });
  ordEl.addEventListener('click', function(e){
    var r=e.target.closest('.rl'); if(!r||busy||tbl==null) return;
    var id=r.getAttribute('data-id');
    if(orders[tbl][id]>0){ orders[tbl][id]--; if(!orders[tbl][id]) delete orders[tbl][id]; }
    renderOrder(); syncTerm();
  });
  mkGrid.addEventListener('click', function(e){
    var b=e.target.closest('.mki'); if(!b||busy) return;
    var id=b.getAttribute('data-id');
    if(!cart[id]){ cart[id]=0; cartOrder.push(id); }
    cart[id]++;
    beep();
    b.classList.add('hit'); setTimeout(function(){b.classList.remove('hit');},180);
    renderScan(); syncTerm();
    var row=scanBody.querySelector('tr[data-id="'+id+'"]');
    if(row){ row.classList.add('hit'); setTimeout(function(){row.classList.remove('hit');},600); }
  });
  scanBody.addEventListener('click', function(e){
    var r=e.target.closest('tr[data-id]'); if(!r||busy) return;
    var id=r.getAttribute('data-id');
    cart[id]--; if(!cart[id]){ delete cart[id]; cartOrder=cartOrder.filter(function(k){return k!==id;}); }
    renderScan(); syncTerm();
  });
  /* ---- pay flow ---- */
  function pay(){
    if(busy || activeTotal()===0) return; busy=true;
    var sq=L()==='sq', paidMode=mode, paidTbl=tbl;
    fillReceipt(); syncTerm();
    var pb = paidMode==='rest' ? restPay : mkPay;
    pb.classList.add('pressed'); pb.disabled=true;
    st.textContent=sq?'PRIT KARTELËN…':'PRESENT CARD…';
    setTimeout(function(){ st.textContent=sq?'DUKE LEXUAR…':'READING…'; },900);
    setTimeout(function(){ pt.classList.add('ok'); st.textContent='APPROVED ✓'; },1700);
    setTimeout(function(){ bill.classList.add('gone'); },2300);
    setTimeout(function(){ fw.classList.add('on'); rc.classList.add('printing'); st.textContent=sq?'DUKE FISKALIZUAR…':'FISCALISING…'; },2900);
    setTimeout(function(){ doneBeep(); sef.classList.add('ok2'); sef.textContent=sq?'SEF ✓ FISKALIZUAR · QR AKTIV':'SEF ✓ FISCALISED · QR ACTIVE'; st.textContent=sq?'KUPONI FISKAL ✓':'FISCAL COUPON ✓'; },6800);
    setTimeout(function(){
      pt.classList.remove('ok'); sef.classList.remove('ok2');
      sef.textContent='SEF · KUPON FISKAL I DIGJITALIZUAR';
      fw.classList.remove('on'); rc.classList.remove('printing'); void rc.offsetWidth;
      bill.classList.remove('gone'); pb.classList.remove('pressed');
      if(paidMode==='rest'){ orders[paidTbl]={}; tbl=null; menuV.hidden=true; floorV.hidden=false; }
      else { cart={}; cartOrder=[]; }
      busy=false; renderAll();
    }, 11200);
  }
  restPay.addEventListener('click', pay);
  mkPay.addEventListener('click', pay);
  /* ---- reduced motion ---- */
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){
    cart={buke:1, qumesht:2}; cartOrder=['buke','qumesht'];
    fillReceipt(); renderAll();
    st.textContent='APPROVED ✓'; pt.classList.add('ok'); rc.classList.add('printing'); sef.classList.add('ok2');
    return;
  }
  renderAll();
})();
</script>
