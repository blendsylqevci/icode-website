---
import Base from '../layouts/Base.astro';
---
<Base
  title="Industritë — iCode LLC"
  description="Industritë që mbulon iCode: ndërtimtari & patundshmëri, shëndetësi, retail & e-commerce, arsim, financë, logjistikë dhe më shumë."
>

<section class="page-hero">
  <div class="container-wide">
    <div class="crumbs"><a href="/" data-sq="Ballina" data-en="Home">Ballina</a><span class="sep">/</span><span data-sq="Industritë" data-en="Industries">Industritë</span></div>
    <h1 data-reveal data-sq="Përvojë në industri që e njohim mirë" data-en="Experience in industries we know well">Përvojë në industri që e njohim mirë</h1>
    <p class="lead" data-reveal data-reveal-delay="1" data-sq="Çdo industri ka sfidat e veta. Ne sjellim njohuri specifike dhe zgjidhje që funksionojnë në kontekstin tënd." data-en="Every industry has its own challenges. We bring specific knowledge and solutions that work in your context.">Çdo industri ka sfidat e veta. Ne sjellim njohuri specifike dhe zgjidhje që funksionojnë në kontekstin tënd.</p>
  </div>
</section>

<section class="section">
  <div class="container-wide">
    <div class="grid cols-3" id="ind-grid"></div>
  </div>
</section>

<section class="section bg-soft">
  <div class="container-wide">
    <div class="sec-head center" data-reveal>
      <span class="eyebrow" data-sq="Partnerët & teknologjitë" data-en="Partners & technologies">Partnerët & teknologjitë</span>
      <h2 data-sq="Bashkëpunojmë me më të mirët e fushës" data-en="We work with the best in the field">Bashkëpunojmë me më të mirët e fushës</h2>
      <p class="lead" data-sq="Platformat tona ndërtohen mbi teknologjitë e liderëve botërorë — me çertifikime, partneritete dhe përvojë reale prodhimi në secilën." data-en="Our platforms are built on the technologies of global leaders — with certifications, partnerships and real production experience in each.">Platformat tona ndërtohen mbi teknologjitë e liderëve botërorë — me çertifikime, partneritete dhe përvojë reale prodhimi në secilën.</p>
    </div>
    <div class="logo-wall" data-reveal style="margin-bottom:clamp(40px,5vw,64px);">
      <span class="logo-item">Microsoft</span>
      <span class="logo-item">.NET</span>
      <span class="logo-item">Microsoft Azure</span>
      <span class="logo-item">AWS</span>
      <span class="logo-item">Claude</span>
      <span class="logo-item">OpenAI Codex</span>
      <span class="logo-item">GitHub</span>
      <span class="logo-item">Docker</span>
      <span class="logo-item">SQL Server</span>
      <span class="logo-item">Shopware</span>
      <span class="logo-item">Shopify</span>
      <span class="logo-item">Unity</span>
    </div>
    <div class="grid cols-4">
      <div class="card" data-reveal><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17.5 19a4.5 4.5 0 000-9 6 6 0 00-11.3 1.6A4 4 0 007 19z"/></svg></div><h3>Cloud</h3><p data-sq="Microsoft Azure si shtëpia jonë kryesore — dhe AWS aty ku e kërkon klienti. Infrastrukturë si kod, monitorim 24/7." data-en="Microsoft Azure as our primary home — and AWS where the client requires it. Infrastructure as code, 24/7 monitoring.">Microsoft Azure si shtëpia jonë kryesore — dhe AWS aty ku e kërkon klienti. Infrastrukturë si kod, monitorim 24/7.</p></div>
      <div class="card" data-reveal data-reveal-delay="1"><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg></div><h3>AI</h3><p data-sq="Ndërtojmë me modelet e Anthropic (Claude) dhe OpenAI (Codex/GPT) — asistentë, automatizim dokumentesh dhe kod më i shpejtë, me evals e guardrails." data-en="We build with Anthropic (Claude) and OpenAI (Codex/GPT) models — assistants, document automation and faster code, with evals and guardrails.">Ndërtojmë me modelet e Anthropic (Claude) dhe OpenAI (Codex/GPT) — asistentë, automatizim dokumentesh dhe kod më i shpejtë, me evals e guardrails.</p></div>
      <div class="card" data-reveal><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h2l2.2 11h10l2-8H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg></div><h3>Commerce</h3><p data-sq="Shopware dhe Shopify për dyqanet — me integrime të thella në ERP, plugin-e tona dhe migrimet pa humbje SEO." data-en="Shopware and Shopify for stores — with deep ERP integrations, our own plugins and SEO-safe migrations.">Shopware dhe Shopify për dyqanet — me integrime të thella në ERP, plugin-e tona dhe migrimet pa humbje SEO.</p></div>
      <div class="card" data-reveal data-reveal-delay="1"><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg></div><h3 data-sq="Platforma Microsoft" data-en="Microsoft platform">Platforma Microsoft</h3><p data-sq=".NET, C#, SQL Server dhe GitHub — themeli i çdo platforme tonë: i qëndrueshëm, i dokumentuar dhe me mbështetje afatgjatë." data-en=".NET, C#, SQL Server and GitHub — the foundation of every platform we ship: stable, documented and supported long-term.">.NET, C#, SQL Server dhe GitHub — themeli i çdo platforme tonë: i qëndrueshëm, i dokumentuar dhe me mbështetje afatgjatë.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container-wide">
    <div class="split">
      <div data-reveal>
        <span class="eyebrow" data-sq="Çdo industri" data-en="Any industry">Çdo industri</span>
        <h2 data-sq="Nuk e sheh industrinë tënde këtu?" data-en="Don't see your industry here?">Nuk e sheh industrinë tënde këtu?</h2>
        <p class="lead mt-m" data-sq="Procesi ynë funksionon në çdo fushë. Fillojmë gjithmonë me të kuptuarit e biznesit tënd para se të propozojmë një zgjidhje." data-en="Our process works in any field. We always start by understanding your business before proposing a solution.">Procesi ynë funksionon në çdo fushë. Fillojmë gjithmonë me të kuptuarit e biznesit tënd para se të propozojmë një zgjidhje.</p>
        <a class="btn btn-primary mt-l" href="/contact" data-sq="Bisedo me ne" data-en="Talk to us">Bisedo me ne</a>
      </div>
      <ul class="check-list" data-reveal data-reveal-delay="2" style="background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:34px;">
        <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12l5 5L19 7"/></svg></span><span data-sq="Startup-e që lansojnë produktin e parë" data-en="Startups launching their first product">Startup-e që lansojnë produktin e parë</span></li>
        <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12l5 5L19 7"/></svg></span><span data-sq="Biznese që digjitalizojnë procese" data-en="Businesses digitising processes">Biznese që digjitalizojnë procese</span></li>
        <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12l5 5L19 7"/></svg></span><span data-sq="Kompani që duan të rriten online" data-en="Companies that want to grow online">Kompani që duan të rriten online</span></li>
        <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12l5 5L19 7"/></svg></span><span data-sq="Institucione me nevoja softuerike" data-en="Institutions with software needs">Institucione me nevoja softuerike</span></li>
      </ul>
    </div>
  </div>
</section>

</Base>

<script>
import '../scripts/site.js';
(function(){
  var IC=window.ICODE_ICON;
  var inds=[
    {ico:'cube',sq:'Ndërtimtari & Patundshmëri',en:'Construction & Real Estate',dsq:'Konfiguratorë 3D, portale projektesh dhe vegla shitjeje.',den:'3D configurators, project portals and sales tools.'},
    {ico:'users',sq:'Shëndetësi',en:'Healthcare',dsq:'Sisteme terminësh, aplikacione pacientësh dhe portale klinikash.',den:'Booking systems, patient apps and clinic portals.'},
    {ico:'cart',sq:'Retail & E-Commerce',en:'Retail & E-Commerce',dsq:'Dyqane online, integrime pagesash dhe menaxhim inventari.',den:'Online stores, payment integrations and inventory management.'},
    {ico:'layers',sq:'Arsim',en:'Education',dsq:'Platforma e-learning, portale shkollash dhe vegla mësimore.',den:'E-learning platforms, school portals and learning tools.'},
    {ico:'chart',sq:'Financë & Fintech',en:'Finance & Fintech',dsq:'Sisteme faturimi, dashboard-e dhe zgjidhje pagesash.',den:'Billing systems, dashboards and payment solutions.'},
    {ico:'rocket',sq:'Logjistikë',en:'Logistics',dsq:'Ndjekje dërgesash, optimizim rrugësh dhe panele operatorësh.',den:'Shipment tracking, route optimisation and operator panels.'},
    {ico:'globe',sq:'Turizëm & Hoteleri',en:'Tourism & Hospitality',dsq:'Sisteme rezervimi, faqe destinacionesh dhe aplikacione.',den:'Booking systems, destination sites and apps.'},
    {ico:'web',sq:'Media & Shërbime',en:'Media & Services',dsq:'Faqe përmbajtjeje, portale dhe vegla të brendshme.',den:'Content sites, portals and internal tools.'},
    {ico:'code',sq:'Prodhim & Industri',en:'Manufacturing',dsq:'Sisteme ERP, menaxhim prodhimi dhe automatizim.',den:'ERP systems, production management and automation.'}
  ];
  var g=document.getElementById('ind-grid');
  g.innerHTML=inds.map(function(x,i){return '<div class="card" data-reveal data-reveal-delay="'+((i%3)+1)+'"><div class="line-ico">'+IC[x.ico]+'</div><h3 data-sq="'+x.sq+'" data-en="'+x.en+'">'+x.sq+'</h3><p data-sq="'+x.dsq+'" data-en="'+x.den+'">'+x.dsq+'</p></div>';}).join('');
  var lang='sq';try{lang=localStorage.getItem('icode-lang')||'sq';}catch(e){}
  g.querySelectorAll('[data-sq]').forEach(function(el){var v=el.getAttribute('data-'+lang);if(v!=null)el.textContent=v;});
  if(window.ICODE_scan)window.ICODE_scan();
})();
</script>
