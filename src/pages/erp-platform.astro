<script>
(function(){
  function $(id){return document.getElementById(id);}
  function num(id){var v=parseFloat($(id).value);return isNaN(v)?0:v;}
  function fmt(n){return n.toLocaleString('en-US',{maximumFractionDigits:0});}
  document.querySelectorAll('.ctab').forEach(function(t){
    t.addEventListener('click',function(){
      document.querySelectorAll('.ctab').forEach(function(x){x.classList.remove('on');});
      document.querySelectorAll('.cbody').forEach(function(x){x.classList.remove('on');});
      t.classList.add('on'); $('cb-'+t.getAttribute('data-ct')).classList.add('on');
    });
  });
  function calc(){
    $('roi-out').textContent=fmt(num('roi-h')*num('roi-c')*12*(num('roi-p')/100))+' €';
    var p=num('mg-p'),c=num('mg-c'),m=p>0?((p-c)/p*100):0;
    $('mg-out').textContent=m.toFixed(1)+'% · '+fmt(p-c)+' €';
    var n=num('tv-n'),r=num('tv-r'),t=n*r/100;
    $('tv-out').textContent=fmt(t)+' € · '+fmt(n+t)+' €';
    var b=num('pg-b'),k=b*0.05,tb=b-k,tax=0;
    tax+=Math.max(0,Math.min(tb,80)-0)*0;
    tax+=Math.max(0,Math.min(tb,250)-80)*0.04;
    tax+=Math.max(0,Math.min(tb,450)-250)*0.08;
    tax+=Math.max(0,tb-450)*0.10;
    $('pg-out').textContent=fmt(tb-tax)+' € · '+fmt(k)+' € · '+fmt(tax)+' €';
  }
  document.querySelectorAll('.cbody input').forEach(function(i){i.addEventListener('input',calc);});
  calc();
})();
</script>
