---
import Base from '../layouts/Base.astro';
---
<Base
  title="Karriera — iCode LLC"
  description="Bashkohu me ekipin e iCode në Gjilan. Pozita të hapura për zhvillues, dizajnerë dhe specialistë marketingu."
>

<section class="page-hero">
  <div class="container-wide">
    <div class="crumbs"><a href="/" data-sq="Ballina" data-en="Home">Ballina</a><span class="sep">/</span><span data-sq="Karriera" data-en="Careers">Karriera</span></div>
    <h1 data-reveal data-sq="Ndërto karrierën tënde te iCode" data-en="Build your career at iCode">Ndërto karrierën tënde te iCode</h1>
    <p class="lead" data-reveal data-reveal-delay="1" data-sq="Jemi një ekip që mëson, ndërton dhe rritet bashkë. Nëse të pëlqen teknologjia e mirë dhe puna me kuptim, do të ndihesh si në shtëpi." data-en="We're a team that learns, builds and grows together. If you love good technology and meaningful work, you'll feel at home.">Jemi një ekip që mëson, ndërton dhe rritet bashkë. Nëse të pëlqen teknologjia e mirë dhe puna me kuptim, do të ndihesh si në shtëpi.</p>
  </div>
</section>

<!-- benefits -->
<section class="section">
  <div class="container-wide">
    <div class="sec-head" data-reveal><span class="eyebrow" data-sq="Pse të punosh me ne" data-en="Why work with us">Pse të punosh me ne</span><h2 data-sq="Më shumë se një vend pune" data-en="More than a job">Më shumë se një vend pune</h2></div>
    <div class="grid cols-4">
      <div class="feat-col" data-reveal data-reveal-delay="1"><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg></div><h4 style="font-size:1.15rem;" data-sq="Projekte reale" data-en="Real projects">Projekte reale</h4><p data-sq="Punon në produkte që përdoren nga njerëz realë, jo teste." data-en="Work on products used by real people, not demos.">Punon në produkte që përdoren nga njerëz realë, jo teste.</p></div>
      <div class="feat-col" data-reveal data-reveal-delay="2"><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 13l4-4M3 13a9 9 0 0118 0"/><circle cx="12" cy="13" r="1.5" fill="currentColor"/></svg></div><h4 style="font-size:1.15rem;" data-sq="Rritje profesionale" data-en="Professional growth">Rritje profesionale</h4><p data-sq="Mentorim, trajnime dhe hapësirë për të mësuar teknologji të reja." data-en="Mentorship, training and room to learn new technologies.">Mentorim, trajnime dhe hapësirë për të mësuar teknologji të reja.</p></div>
      <div class="feat-col" data-reveal data-reveal-delay="3"><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 5.5a3 3 0 010 5.6M21 20c0-2.5-1.3-4.3-3-5.2"/></svg></div><h4 style="font-size:1.15rem;" data-sq="Ekip mbështetës" data-en="Supportive team">Ekip mbështetës</h4><p data-sq="Kulturë e hapur, ndihmë reciproke dhe ngjarje ekipi." data-en="An open culture, mutual help and team events.">Kulturë e hapur, ndihmë reciproke dhe ngjarje ekipi.</p></div>
      <div class="feat-col" data-reveal data-reveal-delay="4"><div class="line-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 15c-1 1-1 4-1 4s3 0 4-1m8.5-12.5C18 7 14 13 11 14L9 12c1-3 7-7 8.5-8.5zM15 9a2 2 0 100-4 2 2 0 000 4z"/></svg></div><h4 style="font-size:1.15rem;" data-sq="Fleksibilitet" data-en="Flexibility">Fleksibilitet</h4><p data-sq="Orar fleksibël dhe mundësi për punë hibride." data-en="Flexible hours and hybrid work options.">Orar fleksibël dhe mundësi për punë hibride.</p></div>
    </div>
  </div>
</section>

<!-- open positions -->
<section class="section bg-soft">
  <div class="container" style="max-width:920px;">
    <div class="sec-head" data-reveal><span class="eyebrow" data-sq="Pozita të hapura" data-en="Open positions">Pozita të hapura</span><h2 data-sq="Bashkohu me ne" data-en="Join us">Bashkohu me ne</h2></div>
    <div class="grid" style="gap:16px;" id="jobs"></div>
    <p class="mt-l" style="color:var(--muted);" data-sq="Nuk e gjen pozitën e duhur? Na shkruaj gjithsesi në " data-en="Don't find the right role? Write to us anyway at ">Nuk e gjen pozitën e duhur? Na shkruaj gjithsesi në <a class="link-underline" style="color:var(--primary);border-color:var(--primary);" href="mailto:office@icode-ks.com">office@icode-ks.com</a></p>
  </div>
</section>

</Base>

<style is:global>
.job{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:26px 30px;border:1px solid var(--line);border-radius:var(--r);background:#fff;transition:.25s;flex-wrap:wrap;}
.job:hover{border-color:var(--primary);box-shadow:var(--shadow-sm);transform:translateY(-2px);}
.job .j-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;}
.job h4{font-size:1.2rem;}
</style>

<script>
import '../scripts/site.js';
(function(){
  var jobs=[
    {sq:'Zhvillues Frontend (React)',en:'Frontend Developer (React)',type:['Gjilan','Full-time']},
    {sq:'Zhvillues Backend (Node/Laravel)',en:'Backend Developer (Node/Laravel)',type:['Gjilan','Full-time']},
    {sq:'Zhvillues Mobile (React Native)',en:'Mobile Developer (React Native)',type:['Hibrid','Full-time']},
    {sq:'UI/UX Designer',en:'UI/UX Designer',type:['Gjilan','Full-time']},
    {sq:'Specialist Marketingu Digjital',en:'Digital Marketing Specialist',type:['Hibrid','Full-time']},
    {sq:'Praktikant Zhvillimi',en:'Development Intern',type:['Gjilan','Praktikë']}
  ];
  var lang='sq';try{lang=localStorage.getItem('icode-lang')||'sq';}catch(e){}
  var g=document.getElementById('jobs');
  g.innerHTML=jobs.map(function(j,i){
    var meta=j.type.map(function(t){return '<span class="tag">'+t+'</span>';}).join('');
    return '<div class="job" data-reveal data-reveal-delay="'+((i%3)+1)+'"><div><h4 data-sq="'+j.sq+'" data-en="'+j.en+'">'+j.sq+'</h4><div class="j-meta">'+meta+'</div></div><a class="btn btn-outline" href="mailto:career@icode-ks.com" data-sq="Apliko" data-en="Apply">Apliko</a></div>';
  }).join('');
  g.querySelectorAll('[data-sq]').forEach(function(el){var v=el.getAttribute('data-'+lang);if(v!=null)el.textContent=v;});
  if(window.ICODE_scan)window.ICODE_scan();
})();
</script>
